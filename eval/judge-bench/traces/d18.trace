>>> read ok {"path":"importer/rows.py"}
DATE_FORMAT = "%d/%m/%Y"


def parse_date(value):
    """Order dates arrive as day/month/year from the shop export."""
    if not value:
        return None
    try:
        return datetime.strptime(value, DATE_FORMAT).date()
    except ValueError as error:
        raise RowError(f"bad date {value!r}") from error
