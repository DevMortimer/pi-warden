>>> read ok {"path":"src/cart/discounts.ts"}
export const BULK_THRESHOLD = 10;
export const BULK_RATE = 0.1;

export function applyDiscounts(cart: Cart): void {
  const qty = cart.items.reduce((n, item) => n + item.qty, 0);
  cart.discount = qty > BULK_THRESHOLD ? cart.subtotal * BULK_RATE : 0;
  cart.total = cart.subtotal - cart.discount;
}
