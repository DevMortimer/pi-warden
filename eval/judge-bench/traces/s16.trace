>>> read ok {"path":"src/text.lisp"}
(defun trim-string (s)
  "Remove surrounding whitespace from S."
  (string-trim '(#\Space #\Newline) s))

(defun split-words (s)
  "Split S on spaces."
  (let ((words '()) (start 0))
    (loop for i from 0 to (length s)
          do (when (or (= i (length s)) (char= (char s i) #\Space))
               (push (subseq s start i) words)
               (setf start (1+ i))))
    (nreverse words)))

(defun join-words (words separator)
  "Join WORDS with SEPARATOR."
  (format nil (concatenate 'string "~{~A~^" separator "~}") words))

