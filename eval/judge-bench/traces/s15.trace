import { readFileSync } from "node:fs";

export interface Config {
  settings: Record<string, string>;
}

const DEFAULT_PATH = "config/app.json";

/**
 * Reads the app config. Values are strings as written in the file; callers convert them.
 */
export function loadConfig(path?: string): Config {
  return JSON.parse(readFileSync(path ?? DEFAULT_PATH, "utf8"));
}
