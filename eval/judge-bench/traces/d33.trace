>>> read ok {"path":"scripts/migrate.py"}
import csv
import sys


def rows(path):
    with open(path, newline="") as f:
        for row in csv.DictReader(f):
            if not row["email"]:
                continue
            yield row


if __name__ == "__main__":
    for row in rows(sys.argv[1]):
        print(row["id"], row["email"])

