export interface ProgressBarProps {
  value: number;
  max?: number;
}

export function ProgressBar({ value, max = 100 }: ProgressBarProps) {
  const percent = (value / max) * 100;
  return <div role="progressbar" aria-valuenow={value} style={{ width: `${percent}%` }} />;
}
>>> edit ok {"path":"src/components/ProgressBar.tsx","oldText":"export interface ProgressBarProps {\n  value: number;\n  max?: number;\n}\n\nexport function ProgressBar({ value, max = 100 }: ProgressBarProps) {\n  const percent = (value / max) * 100;","newText":"export interface ProgressBarProps {\n  value: number;\n  max?: number;\n  clamp?: boolean;\n}\n\nexport function ProgressBar({ value, max = 100, clamp = false }: ProgressBarProps) {\n  const raw = (value / max) * 100;\n  const percent = clamp ? Math.min(100, Math.max(0, raw)) : raw;"}
