export async function retry<T>(fn: () => Promise<T>, { maxAttempts = 3, delayMs = 100 } = {}): Promise<T> {
  let attempt = 0;
  for (;;) {
    try {
      return await fn();
    } catch (error) {
      attempt++;
      await sleep(delayMs * attempt);
    }
  }
}
