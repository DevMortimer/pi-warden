>>> edit ok {"path":"src/routes/orders.ts","oldText":"router.get(\"/orders\", async (req, res) => {\n  const orders = await listOrders();\n  res.json(orders);\n});","newText":"router.get(\"/orders\", async (req, res) => {\n  const page = Math.max(1, Number(req.query.page ?? 1));\n  const limit = Math.min(100, Number(req.query.limit ?? 20));\n  const { rows, total } = await listOrders({ offset: (page - 1) * limit, limit });\n  res.json({ items: rows, page, limit, total });\n});"}
